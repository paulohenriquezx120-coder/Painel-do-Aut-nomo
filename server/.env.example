# Copie este arquivo para ".env" e preencha.

# Opcional no começo: só necessário para o servidor confirmar pagamentos
# automaticamente (verify-session) e para o webhook/portal de assinatura.
# Dashboard > Developers > API keys > Secret key
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Planos usados pelos botões de assinar (não exigem chave secreta)
STRIPE_PLAN_CURRENCY=brl

STRIPE_PLAN_MONTHLY_AMOUNT=3990
STRIPE_PLAN_MONTHLY_LINK=https://buy.stripe.com/test_...

STRIPE_PLAN_QUARTERLY_AMOUNT=8990
STRIPE_PLAN_QUARTERLY_LINK=https://buy.stripe.com/test_...

# URL do frontend, usada nos redirecionamentos do Portal do Stripe
CLIENT_URL=http://localhost:5173

# Dias de teste grátis antes de exigir assinatura
TRIAL_DAYS=7
