# Copie este arquivo para ".env" e preencha.

# Banco de dados (Turso) — turso.tech, plano gratuito
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=eyJ...

# E-mails com acesso liberado sem precisar assinar (separados por vírgula)
ADMIN_EMAILS=

# Envio de e-mail de redefinição de senha (resend.com, plano gratuito)
RESEND_API_KEY=re_...
RESEND_FROM=Painel do Autônomo <onboarding@resend.dev>

# Gateway de pagamento: Asaas (asaas.com). Dashboard > Integrações > API.
# ASAAS_ENV=sandbox usa a conta de testes (sandbox.asaas.com); production usa a real.
ASAAS_ENV=sandbox
ASAAS_API_KEY=$aact_...
# Definido em Dashboard > Integrações > Webhooks ao cadastrar a URL do webhook.
ASAAS_WEBHOOK_TOKEN=

# Planos usados pelos botões de assinar (valor em centavos)
ASAAS_PLAN_CURRENCY=brl

ASAAS_PLAN_MONTHLY_AMOUNT=3990
ASAAS_PLAN_QUARTERLY_AMOUNT=8990

# URL do frontend
CLIENT_URL=http://localhost:5173

# --- Stripe (legado/opcional, mantido caso volte a ser usado) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLAN_CURRENCY=brl
STRIPE_PLAN_MONTHLY_AMOUNT=3990
STRIPE_PLAN_MONTHLY_LINK=https://buy.stripe.com/test_...
STRIPE_PLAN_QUARTERLY_AMOUNT=8990
STRIPE_PLAN_QUARTERLY_LINK=https://buy.stripe.com/test_...

# Dias de teste grátis antes de exigir assinatura
TRIAL_DAYS=7
